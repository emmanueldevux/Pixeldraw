// ============================================================
// UXLLY — Database Schema (Prisma)
// Multi-tenant foundation · Brand → Channel → Content
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Auth Models ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed — null for OAuth-only users
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  brands   Brand[]
  jobs     Job[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== Brand & Style Guide ====================

model Brand {
  id           String   @id @default(cuid())
  userId       String
  name         String
  logo         String?  // URL (or base64 data URL fallback) to uploaded logo
  logoPosition String   @default("bottom-right") // top-left, top-right, bottom-left, bottom-right, center
  logoScale    Float    @default(0.14) // logo width as a fraction of canvas width
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  styleGuide StyleGuide?
  channels   Channel[]

  @@index([userId])
}

model StyleGuide {
  id              String   @id @default(cuid())
  brandId         String   @unique
  primaryColor    String   @default("#2563EB")
  secondaryColor  String   @default("#1D4ED8")
  accentColor     String   @default("#22C55E")
  backgroundColor String   @default("#FFFFFF")
  headingFont     String   @default("Inter")
  bodyFont        String   @default("Inter")
  tone            String   @default("professional") // professional, casual, bold, minimal
  extraNotes      String?  @db.Text // free-form style notes
  referenceImages Json?    // array of URLs to reference images
  rawMarkdown     String?  @db.Text // uploaded .md style guide content
  layoutArchetypes Json?   // array of {name, composition} extracted from grid/moodboard references
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

// ==================== Channels (Projects) ====================

model Channel {
  id             String   @id @default(cuid())
  brandId        String
  name           String   // e.g. "TikTok Main", "Instagram Business"
  platform       String   // instagram, tiktok, twitter, linkedin, etc.
  description    String?
  styleOverrides Json?    // channel-specific style overrides
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  posts         Post[]
  conversations Conversation[]
  jobs          Job[]

  @@index([brandId])
}

// ==================== AI Conversations ====================

model Conversation {
  id        String   @id @default(cuid())
  channelId String
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([channelId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user, assistant, system
  content        String   @db.Text
  imageUrl       String?  // if the message includes a generated image
  metadata       Json?    // generation params, model used, etc.
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ==================== Content Calendar ====================

model Post {
  id          String    @id @default(cuid())
  channelId   String
  title       String?
  caption     String?   @db.Text
  imageUrl    String?
  platform    String    // matches channel platform
  size        String    @default("1080x1080") // e.g. "1080x1920"
  status      String    @default("draft") // draft, scheduled, published, failed
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([scheduledAt])
  @@index([status])
}

// ==================== Inspiration Library ====================
// Curated "creative injection" pool — separate from any one brand's
// own references. Tagged by category so the AI can pull a small,
// relevant pool and borrow ONE technique (never colors/fonts) to
// keep brand generations from feeling repetitive.

model InspirationImage {
  id        String   @id @default(cuid())
  url       String   // R2 URL
  platform  String?  // matches PlatformKey, null = any platform
  style     String?  // e.g. "minimal", "editorial", "3d render", "maximalist"
  mood      String?  // e.g. "energetic", "calm", "luxury", "playful"
  industry  String?  // e.g. "fitness", "saas", "fashion"
  tags      String[] // catch-all extra tags
  addedBy   String?  // userId who tagged it
  createdAt DateTime @default(now())

  @@index([platform])
  @@index([style])
  @@index([mood])
}

// ==================== Scheduled Jobs ====================

model Job {
  id           String   @id @default(cuid())
  userId       String
  channelId    String
  name         String
  prompt       String   @db.Text // what to generate
  schedule     String   // cron expression or "09:00,17:00"
  platform     String
  size         String   @default("1080x1080")
  deliveryEmail    Boolean @default(true)
  deliveryTelegram Boolean @default(false)
  deliverySocial   Boolean @default(false)
  telegramChatId   String?
  isActive     Boolean  @default(true)
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}
